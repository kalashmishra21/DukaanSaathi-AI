# Mock is the safe default. Gnani uses Prisma/Timbre with mock intent reasoning.
AI_PROVIDER=mock

# Supabase project URL and public anon/publishable key. Copy to .env.local.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-side only. Required when AI_PROVIDER=gnani; never prefix NEXT_PUBLIC_.
GNANI_API_KEY=
