# Mock is the safe default for voice and intent reasoning.
AI_PROVIDER=mock
AI_REASONER=mock

# OpenRouter is an optional server-side reasoner. Use a :free model unless you explicitly approve paid usage.
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
OPENROUTER_API_KEY=

# Supabase project URL and public anon/publishable key. Copy to .env.local.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-side only. Required when AI_PROVIDER=gnani; never prefix NEXT_PUBLIC_.
GNANI_API_KEY=
